# Figma分流规则
# Update: 20260609
# from https://help.figma.com/hc/en-us/articles/19424714305943-Adjust-your-network-settings
# 使用教程：https://trains-fetch-zwa.craft.me/V0bf5oAg4nIReY

# figma
#DOMAIN,static.figma.com //静态资源
#DOMAIN,s3-alpha.figma.com //用户内容
#DOMAIN,s3-alpha-sig.figma.com //文件存储
DOMAIN-SUFFIX,figma.com
DOMAIN-SUFFIX,makeproxy-c.figma.site
DOMAIN-SUFFIX,makeproxy-m.figma.site
DOMAIN-SUFFIX,figma.site

# CDN
 #DOMAIN,esm.sh
DOMAIN-SUFFIX,esm.sh
DOMAIN-SUFFIX,jsdelivr.net
DOMAIN,registry.npmjs.org

DOMAIN-SUFFIX,figma.net
DOMAIN-SUFFIX,figmacdn.net
DOMAIN-SUFFIX,figmausercontent.com

# Desk
DOMAIN,desktop.figmaxcom

# Gov
DOMAIN-SUFFIX,figma-gov.com
DOMAIN-SUFFIX,figma-gov.site
DOMAIN-SUFFIX,makeproxy-c.figma-gov.site

#font
DOMAIN,fonts.gstatic.com

#figma插件
DOMAIN-SUFFIX,code.jquery.com

#zendesk
DOMAIN-SUFFIX,zdassets.com
DOMAIN-SUFFIX,zendesk.com

# 第三方服务
DOMAIN-SUFFIX,clearbit.com
DOMAIN-SUFFIX,clearbitjs.com
# DOMAIN-SUFFIX,api.segment.io
DOMAIN-SUFFIX,segment.com
DOMAIN-SUFFIX,segment.io
# DOMAIN-SUFFIX,wp.com
DOMAIN-SUFFIX,gravatar.com
# DOMAIN-SUFFIX,fontawesome.com
DOMAIN-SUFFIX,statsigapi.net
